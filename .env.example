# Used by scripts/fetch-events.ts at build time to bake season/event dates from D1.
# All optional: when any is missing the build keeps the committed src/lib/data/events.json
# (empty by default, so the site then shows hardcoded fallbacks only).
#
# Set the same three as build variables in Cloudflare (Workers Builds > Settings > Variables).
# The ingest Worker's REBUILD_HOOK_URL secret must point at this project's deploy hook
# so new events trigger a rebuild.

# Cloudflare API token, permission: Account > D1 > Read (nothing else needed)
CF_API_TOKEN=
# Cloudflare account id
CF_ACCOUNT_ID=
# D1 database id of `resetwatch` (resetwatch-ingest/wrangler.jsonc)
D1_DATABASE_ID=9b069aa9-30a5-4f9a-bc05-72be9e0501ec
