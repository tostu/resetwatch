# Used by scripts/fetch-events.ts at build time to bake season/event dates from D1.
# All optional: when any is missing the build keeps the committed src/lib/data/events.json.

# Cloudflare API token with D1 read access (D1:Read)
CF_API_TOKEN=
# Cloudflare account id
CF_ACCOUNT_ID=
# D1 database id of `resetwatch`
D1_DATABASE_ID=
