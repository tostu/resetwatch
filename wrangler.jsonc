{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "resetwatch",
	"compatibility_date": "2026-11-17",
	// Assets-only: no `main` = no Worker, static asset requests are free and never invoke a Worker.
	"assets": {
		"directory": "build",
		"not_found_handling": "404-page"
	},
	"workers_dev": true,
	"preview_urls": true
}
